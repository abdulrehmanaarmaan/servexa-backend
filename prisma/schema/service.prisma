model Service {
  id          String @id @default(uuid())

  name        String
  description String?
  basePrice   Decimal? @db.Decimal(10, 2)

  isActive    Boolean @default(true)

  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("services")
}